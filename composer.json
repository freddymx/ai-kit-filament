{
    "name": "freddymx/ai-kit-filament",
    "description": "Filament admin panel for ai-kit: manage collections and documents, view conversations, and demo the chat in a Playground page.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alfredo Pineda",
            "email": "freddy@canariasnetworks.com",
            "role": "Developer"
        }
    ],
    "keywords": ["laravel", "filament", "ai", "rag", "admin"],
    "require": {
        "php": "^8.5",
        "illuminate/support": "^12.0|^13.0",
        "filament/filament": "^5.11",
        "freddymx/ai-kit-core": "^0.4",
        "freddymx/ai-kit-ui-livewire": "^0.4"
    },
    "require-dev": {
        "laravel/framework": "^12.0|^13.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "SolutionForest\\AiKit\\Filament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SolutionForest\\AiKit\\Filament\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4.x-dev"
        },
        "laravel": {
            "providers": [
                "SolutionForest\\AiKit\\Filament\\AiKitFilamentServiceProvider"
            ]
        }
    },
    "repositories": [
        { "type": "path", "url": "../ai-kit-core", "options": { "symlink": true } },
        { "type": "path", "url": "../ai-kit-ui-livewire", "options": { "symlink": true } }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

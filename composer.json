{
    "name": "solution-forest/ai-kit-filament",
    "description": "Filament admin panel for ai-kit: manage collections and documents, view conversations, and demo the chat in a Playground page.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "filament", "ai", "rag", "admin"],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "filament/filament": "^5.0",
        "solution-forest/ai-kit-core": "^0.2",
        "solution-forest/ai-kit-ui-livewire": "^0.2"
    },
    "require-dev": {
        "laravel/framework": "^12.0|^13.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "SolutionForest\\AiKit\\Filament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SolutionForest\\AiKit\\Filament\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        },
        "laravel": {
            "providers": [
                "SolutionForest\\AiKit\\Filament\\AiKitFilamentServiceProvider"
            ]
        }
    },
    "repositories": [
        { "type": "path", "url": "../core", "options": { "symlink": true } },
        { "type": "path", "url": "../ui", "options": { "symlink": true } }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
